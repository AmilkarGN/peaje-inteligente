# ============================================================================
# IAM-811 Machine Learning y Aprendizaje Profundo
# Sistema Inteligente de Control de Peaje - Plantilla de Variables (.env.example)
# Autor: Amilkar Hugo Guarachi Nina
# IMPORTANTE: Copiar este archivo como `.env` en el servidor y completar valores.
# NUNCA subir credenciales reales ni client_secret al repositorio Git.
# ============================================================================

# 1. Configuración General de Django (Aplicación Web y API REST en Subdominio HTTPS)
DJANGO_SECRET_KEY=cambiar_por_clave_secreta_aleatoria_en_produccion
DJANGO_DEBUG=False
ALLOWED_HOSTS=peaje.tudominio.com,api-peaje.tudominio.com

# 2. Base de Datos (SQLite por defecto o MySQL/PostgreSQL en Hosting/Cloud)
DB_ENGINE=django.db.backends.sqlite3
SQLITE_FILENAME=peaje_iam811.sqlite3
# Si usa MySQL en cPanel / Hosting Compartido:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=cpaneluser_peaje
# DB_USER=cpaneluser_admin
# DB_PASSWORD=tu_password_bd_aqui
# DB_HOST=127.0.0.1
# DB_PORT=3306

# 3. URL del Endpoint Único de Inferencia en la Nube (RunPod o Google Colab)
# Cambiar entre RunPod y Google Colab es solo modificar esta variable:
INFERENCE_URL=https://tu-pod-id-8000.proxy.runpod.net

# 4. Autenticación con Google OAuth 2.0 (Web y Android)
GOOGLE_CLIENT_ID=tu_google_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=tu_google_android_client_id.apps.googleusercontent.com

# 5. Tiempo Real con Pusher Channels (Compatible con Hosting Compartido y Cloud)
PUSHER_APP_ID=tu_pusher_app_id
PUSHER_KEY=tu_pusher_key
PUSHER_SECRET=tu_pusher_secret
PUSHER_CLUSTER=us2

# 6. Agente Conversacional (Google Gemini API con Function Calling)
GEMINI_API_KEY=tu_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 7. Entrenamiento y Datasets en Roboflow (Usado en los notebooks de Google Colab)
ROBOFLOW_API_KEY=tu_roboflow_api_key
ROBOFLOW_WORKSPACE=amilkar-peaje
ROBOFLOW_PROJECT_M2=peaje-vehiculos-seg
ROBOFLOW_PROJECT_M3=peaje-ruedas-keypoints
